{
	// Image markup as described in AGENTS.md ("Images"). Afterwards run
	// `python scripts/normalize_images.py content/<article>.md` to add width and height.
	"figure": {
		"scope": "markdown",
		"prefix": "figure",
		"body": [
			"<figure>",
			"    <a href=\"../images/${CURRENT_YEAR}/${CURRENT_MONTH}/${1:image.png}\"><img src=\"../images/${CURRENT_YEAR}/${CURRENT_MONTH}/${1:image.png}\" alt=\"${2:What the image shows}\" loading=\"lazy\"></a>",
			"    <figcaption>${3:Caption}</figcaption>",
			"</figure>",
			"$0"
		],
		"description": "Image with caption; the link opens the full-size file"
	},
	"gallery": {
		"scope": "markdown",
		"prefix": "gallery",
		"body": [
			"<div class=\"gallery\">",
			"    <figure>",
			"        <a href=\"../images/${CURRENT_YEAR}/${CURRENT_MONTH}/${1:image-1.jpg}\"><img src=\"../images/${CURRENT_YEAR}/${CURRENT_MONTH}/${1:image-1.jpg}\" alt=\"${2:What the image shows}\" loading=\"lazy\"></a>",
			"        <figcaption>${3:Caption}</figcaption>",
			"    </figure>",
			"    <figure>",
			"        <a href=\"../images/${CURRENT_YEAR}/${CURRENT_MONTH}/${4:image-2.jpg}\"><img src=\"../images/${CURRENT_YEAR}/${CURRENT_MONTH}/${4:image-2.jpg}\" alt=\"${5:What the image shows}\" loading=\"lazy\"></a>",
			"        <figcaption>${6:Caption}</figcaption>",
			"    </figure>",
			"</div>",
			"$0"
		],
		"description": "Several images in a grid, one figure per image"
	}
}
