&lt;figure&gt;
&lt;a href="../images/2013/09/Calculate-Legendre.png"&gt;&lt;img alt="Pseudocode: Calculate Legendre symbol" height="528" src="../images/2013/09/Calculate-Legendre.png" width="500"/&gt;&lt;/a&gt;
&lt;figcaption&gt;Pseudocode: Calculate Legendre symbol&lt;/figcaption&gt;
&lt;/figure&gt;
&lt;h2 id="python"&gt;Python&lt;/h2&gt;
&lt;div class="highlight"&gt;&lt;pre&gt;&lt;span&gt;&lt;/span&gt;&lt;code&gt;&lt;span class="ch"&gt;#!/usr/bin/env python&lt;/span&gt;
